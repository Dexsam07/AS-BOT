# AS-BOT identity
BOT_NAME=AS-BOT
OWNER_NAME=Shyam Chaudhari
OWNER_NUMBER=917384287404
# No command prefix: use ping, help, status directly
PREFIX=
BOT_MODE=private
BOT_LANGUAGE=en
TIMEZONE=Asia/Kolkata
BOT_VERSION=1.0.0

# Channel branding
CHANNEL_NAME=DEX SHYAM TECH
CHANNEL_ID=120363406449026172@newsletter
CHANNEL_LINK=https://whatsapp.com/channel/0029VbBgXTsKwqSKZKy38w2o

# Session: exact format is DEX~<Base64-payload>
SESSION_PREFIX=DEX~
SESSION_ID=
SESSION_DIR=./data/session

# Runtime feature gates
LOAD_EXTERNAL_PLUGINS=false
ENABLE_REMINDERS=true
ENABLE_MEMORY_GUARD=true
ENABLE_AUDIT=true
AUDIT_FILE=./data/audit.jsonl
LOG_LEVEL=warn

# GitHub self-update (host must be a Git clone of this repository)
UPDATE_REPO=Dexsam07/AS-BOT
UPDATE_BRANCH=main
UPDATE_PROJECT_DIR=.
UPDATE_STATE_FILE=./data/update-state.json
UPDATE_LOCK_FILE=./data/update.lock
# Optional private-repo token; keep it in the hosting secret manager, not source.
# GITHUB_TOKEN=

# Reliability limits
COMMAND_RATE_LIMIT=12
COMMAND_RATE_WINDOW_MS=10000
JOB_MAX_CONCURRENCY=2
JOB_MAX_QUEUE=40
JOB_PER_CHAT_LIMIT=3
JOB_TIMEOUT_MS=180000
MEMORY_LIMIT_MB=512
MEMORY_CLEANUP_PERCENT=70
MEMORY_PAUSE_PERCENT=85
MEMORY_RESTART_PERCENT=92

# Optional provider/database secrets. Keep them outside ZIP/Git.
# AI_API_KEY=
# MEDIA_API_KEY=
# DATABASE_URL=
